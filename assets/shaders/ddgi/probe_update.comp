#version 450 core
// Clasifica y reubica las probes de la lista leyendo sus R rayos recien trazados.
// Reglas de ProbeRelocationCS.hlsl (RTXGI), validadas en
// docs/superpowers/sims/2026-09-26-reubicacion_sim.mjs. Ajustes por trazar contra
// voxeles: distancias cuantizadas (banda muerta entre las reglas 2 y 3, un voxel extra
// en la regla 1) y el cielo empatado en kDdgiSkyDistance (la mas lejana se desempata
// hacia el lado opuesto a la mas cercana).
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D uRays;

#define DDGI_PROBE_DATA_WRITABLE
#define DDGI_PROBE_STATE_WRITABLE
#include "ddgi/common.glsl"
#include "ddgi/update.glsl"

const uint  kHilos     = 256u;
const float kCotaCelda = 0.2025;   // 0.45^2

shared uint  sBackfaces;
shared float sTrasD[kHilos];  shared int sTrasI[kHilos];    // cara trasera mas cercana
shared float sCercaD[kHilos]; shared int sCercaI[kHilos];   // cara delantera mas cercana
shared float sLejosD[kHilos]; shared int sLejosI[kHilos];   // cara delantera mas lejana
shared float sLejosC[kHilos];                               // su coseno con la mas cercana

// A igual distancia gana el indice menor: el resultado no depende del orden de los hilos.
bool Gana(float d, int i, float dRef, int iRef, bool menor) {
    if (i < 0)    return false;
    if (iRef < 0) return true;
    if (d != dRef) return menor ? (d < dRef) : (d > dRef);
    return i < iRef;
}

bool GanaLejos(float d, float c, int i, float dRef, float cRef, int iRef) {
    if (i < 0)    return false;
    if (iRef < 0) return true;
    if (d != dRef) return d > dRef;
    if (c != cRef) return c < cRef;
    return i < iRef;
}

float LeerDistancia(int i, int slot) { return texelFetch(uRays, ivec2(i, slot), 0).a; }

void main() {
    int slot = int(gl_WorkGroupID.x);
    if (slot >= DdgiSlotCount()) return;   // uniforme en el workgroup

    int  probe  = DdgiSlotProbe(slot);
    int  nRayos = DdgiRayCount();
    uint tid    = gl_LocalInvocationIndex;

    if (tid == 0u) sBackfaces = 0u;
    barrier();

    float trasD = 1.0e30, cercaD = 1.0e30;
    int   trasI = -1,     cercaI = -1;
    uint  traseras = 0u;

    for (int i = int(tid); i < nRayos; i += int(kHilos)) {
        float a = LeerDistancia(i, slot);
        if (a < 0.0) {
            traseras += 1u;
            if (Gana(-a, i, trasD, trasI, true)) { trasD = -a; trasI = i; }
        } else if (Gana(a, i, cercaD, cercaI, true)) {
            cercaD = a; cercaI = i;
        }
    }

    atomicAdd(sBackfaces, traseras);
    sTrasD[tid]  = trasD;  sTrasI[tid]  = trasI;
    sCercaD[tid] = cercaD; sCercaI[tid] = cercaI;
    barrier();

    for (uint paso = kHilos / 2u; paso > 0u; paso >>= 1u) {
        if (tid < paso) {
            uint o = tid + paso;
            if (Gana(sTrasD[o], sTrasI[o], sTrasD[tid], sTrasI[tid], true)) {
                sTrasD[tid] = sTrasD[o]; sTrasI[tid] = sTrasI[o];
            }
            if (Gana(sCercaD[o], sCercaI[o], sCercaD[tid], sCercaI[tid], true)) {
                sCercaD[tid] = sCercaD[o]; sCercaI[tid] = sCercaI[o];
            }
        }
        barrier();
    }

    // Segunda pasada: necesita la mas cercana ya resuelta para desempatar.
    vec3 dirCerca = (sCercaI[0] >= 0) ? DdgiRayDirection(sCercaI[0]) : vec3(0.0);

    float lejosD = -1.0, lejosC = 2.0;
    int   lejosI = -1;
    for (int i = int(tid); i < nRayos; i += int(kHilos)) {
        float a = LeerDistancia(i, slot);
        if (a < 0.0) continue;
        float c = dot(DdgiRayDirection(i), dirCerca);
        if (GanaLejos(a, c, i, lejosD, lejosC, lejosI)) { lejosD = a; lejosC = c; lejosI = i; }
    }

    sLejosD[tid] = lejosD; sLejosC[tid] = lejosC; sLejosI[tid] = lejosI;
    barrier();

    for (uint paso = kHilos / 2u; paso > 0u; paso >>= 1u) {
        if (tid < paso) {
            uint o = tid + paso;
            if (GanaLejos(sLejosD[o], sLejosC[o], sLejosI[o],
                          sLejosD[tid], sLejosC[tid], sLejosI[tid])) {
                sLejosD[tid] = sLejosD[o]; sLejosC[tid] = sLejosC[o]; sLejosI[tid] = sLejosI[o];
            }
        }
        barrier();
    }

    if (tid != 0u) return;

    float fraccion = float(sBackfaces) / float(nRayos);
    vec3  offset   = uDdgiProbeData[probe].xyz;
    vec3  nuevo    = offset;
    float minFront = uUpdateReloc.x;
    float voxel    = uUpdateReloc.z;

    if (uUpdateReloc.y < 0.5) {
        nuevo = vec3(0.0);
    } else {
        if (fraccion > uDdgiParams2.y && sTrasI[0] >= 0) {
            // 1. Adentro de algo: atravesar la cara trasera mas cercana. La distancia es
            //    a la ENTRADA del voxel; el voxel extra garantiza pasar la superficie.
            nuevo = offset + DdgiRayDirection(sTrasI[0]) * (sTrasD[0] + voxel + minFront * 0.5);
        } else if (sCercaI[0] >= 0 && sCercaD[0] < minFront) {
            // 2. Pegado a una superficie: hacia la delantera mas lejana, si eso no lo
            //    acerca tambien a la mas cercana.
            vec3 lejos = DdgiRayDirection(sLejosI[0]);
            if (dot(dirCerca, lejos) <= 0.0) nuevo = offset + lejos * min(sLejosD[0], 1.0);
        } else if (sCercaI[0] >= 0 && sCercaD[0] > minFront + voxel) {
            // 3. Libre de sobra: volver hacia la grilla. Un voxel de banda muerta con la
            //    regla 2: sin ella la cuantizacion cruza el umbral y oscila.
            float largo = length(offset);
            if (largo > 1.0e-6) {
                nuevo = offset - (offset / largo) * min(sCercaD[0] - minFront - voxel, largo);
            }
        }
        vec3 enCeldas = nuevo / uDdgiSpacing.xyz;
        if (dot(enCeldas, enCeldas) >= kCotaCelda) nuevo = offset;
    }

    uDdgiProbeData[probe] = vec4(nuevo, fraccion);

    // La historia deja de describir a la probe si se movio mas de un voxel o si cambio
    // entre activa e inactiva: la edad vuelve a 0 y los blends sobreescriben.
    uvec4 estado = uDdgiProbeState[probe];
    uint  ahora  = (fraccion < uUpdateReloc.w) ? 1u : 2u;
    vec3  movido = nuevo - offset;
    bool  reset  = dot(movido, movido) > voxel * voxel
                || (estado.y != 0u && estado.y != ahora);
    uint  edad   = reset ? 0u : min(estado.x + 1u, 255u);
    uDdgiProbeState[probe] = uvec4(edad, ahora, 0u, 0u);
}

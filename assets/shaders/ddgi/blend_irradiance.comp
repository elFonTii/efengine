#version 450 core
// Integra los R rayos de cada probe de la lista al atlas de irradiancia.
// Un workgroup por probe; el local_size es el tile con borde.
layout(local_size_x = 10, local_size_y = 10, local_size_z = 1) in;   // kIrradianceTile + 2

layout(binding = 0) uniform sampler2D uRays;
layout(rgba16f, binding = 0) uniform image2D uIrradianceAtlas;

#define DDGI_WRITES_STATS
#include "ddgi/common.glsl"
#include "ddgi/update.glsl"

shared vec3 sRad[kDdgiMaxRays];
shared vec3 sDir[kDdgiMaxRays];
shared uint sDelta;
shared uint sTexels;

void main() {
    int slot = int(gl_WorkGroupID.x);
    // Uniforme en el workgroup: hace legal el barrier() de abajo.
    if (slot >= DdgiSlotCount()) return;
    int probe = DdgiSlotProbe(slot);

    int   tile     = uDdgiAtlas.z;
    int   bordered = tile + 2 * kDdgiBorder;
    ivec2 local    = ivec2(gl_LocalInvocationID.xy);

    // Borde: el mapa octaedrico envuelve sobre si mismo, asi que el vecino de un texel
    // de borde es un texel interior del mismo tile.
    ivec2 inner = local - ivec2(kDdgiBorder);
    if (inner.x < 0 || inner.x >= tile || inner.y < 0 || inner.y >= tile) {
        if (inner.x < 0)          { inner.x = 0;        inner.y = tile - 1 - inner.y; }
        else if (inner.x >= tile) { inner.x = tile - 1; inner.y = tile - 1 - inner.y; }
        if (inner.y < 0)          { inner.y = 0;        inner.x = tile - 1 - inner.x; }
        else if (inner.y >= tile) { inner.y = tile - 1; inner.x = tile - 1 - inner.x; }
        inner = clamp(inner, ivec2(0), ivec2(tile - 1));
    }
    vec3 dirOct = OctDecode((vec2(inner) + 0.5) / float(tile) * 2.0 - 1.0);

    int nRayos = DdgiRayCount();
    int nHilos = int(gl_WorkGroupSize.x * gl_WorkGroupSize.y);
    if (gl_LocalInvocationIndex == 0u) { sDelta = 0u; sTexels = 0u; }
    for (int i = int(gl_LocalInvocationIndex); i < nRayos; i += nHilos) {
        sDir[i] = DdgiRayDirection(i);
        sRad[i] = texelFetch(uRays, ivec2(i, slot), 0).rgb;
    }
    barrier();

    // Normalizar por la suma de pesos guarda una radiancia uniforme L0 como L0: la
    // convencion de ibl/irradiance_convolve.comp.
    vec3  suma      = vec3(0.0);
    float sumaPesos = 0.0;
    for (int i = 0; i < nRayos; ++i) {
        float coseno = dot(sDir[i], dirOct);
        if (coseno <= 0.0) continue;
        suma      += sRad[i] * coseno;
        sumaPesos += coseno;
    }
    vec3 capturado = (sumaPesos > 0.0) ? suma / sumaPesos : vec3(0.0);

    ivec2 dst    = DdgiTileOrigin(probe, bordered) + local;
    vec3  previo = imageLoad(uIrradianceAtlas, dst).rgb;
    float h      = DdgiEffectiveHysteresis(uDdgiProbeState[probe].x);

    // Cambio grande (RTXGI), comparado en espacio perceptual porque el atlas es HDR
    // lineal: un salto de iluminacion baja la histeresis de este texel, y un salto de
    // brillo enorme se toma de a un cuarto para no meter fireflies.
    if (h > 0.0) {
        vec3 d = abs(pow(max(capturado, vec3(0.0)), vec3(0.2))
                   - pow(max(previo,    vec3(0.0)), vec3(0.2)));
        if (max(d.r, max(d.g, d.b)) > uUpdateHyst.y) h = max(0.0, h - 0.75);
        vec3 delta = capturado - previo;
        if (length(delta) > uUpdateHyst.z) capturado = previo + delta * 0.25;
    }

    vec3 resultado = mix(capturado, previo, h);
    imageStore(uIrradianceAtlas, dst, vec4(resultado, 1.0));

    // Delta perceptual de los texels interiores (el borde es copia): mide convergencia.
    bool borde = any(lessThan(local, ivec2(kDdgiBorder)))
              || any(greaterThanEqual(local, ivec2(tile + kDdgiBorder)));
    if (!borde) {
        vec3 d = abs(pow(max(resultado, vec3(0.0)), vec3(0.2))
                   - pow(max(previo,    vec3(0.0)), vec3(0.2)));
        atomicAdd(sDelta, uint(min(max(d.r, max(d.g, d.b)), 1.0) * kDdgiDeltaScale + 0.5));
        atomicAdd(sTexels, 1u);
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        atomicAdd(uStatDeltaSum, sDelta);
        atomicAdd(uStatDeltaCount, sTexels);
    }
}

#version 450 core
// Integra el target de captura al atlas de momentos de distancia.
//
// Guarda media y media^2 de la distancia por direccion. De estos dos numeros
// sale la varianza, y de la varianza el test de Chebyshev que mata el light
// leaking. Este mapa ES el invento clave de DDGI sobre los sistemas de probes
// anteriores.
//
// Tile mas grande que el de irradiancia: la visibilidad tiene bordes duros y
// necesita mas resolucion angular que una senal difusa.
layout(local_size_x = 18, local_size_y = 18, local_size_z = 1) in;   // kDistanceTile + 2

layout(binding = 0) uniform sampler2D uCapture;
layout(rg16f, binding = 0) uniform image2D uDistanceAtlas;

#include "ddgi/common.glsl"

// Mismo cache por cara que blend_irradiance.comp, y aca pesa mas: son 324 texels
// de salida por probe contra 100, o sea 497.664 texelFetch por probe sin cache.
// Ver el comentario largo de aquel.
shared vec2 sDist[kDdgiFaceTexels];   // x = distancia recortada, y = angulo solido
shared vec3 sDir[kDdgiFaceTexels];

void main() {
    int slot = int(gl_WorkGroupID.x);
    // Uniforme en el workgroup: o salen todas las invocaciones o ninguna. Es lo
    // que hace legales los barrier() de mas abajo.
    if (slot >= uDdgiRange.y) return;

    int total = uDdgiCounts.w;
    int probe = (uDdgiRange.x + slot) % total;

    int tile     = uDdgiAtlas.w;                  // interior, 16
    int bordered = tile + 2 * kDdgiBorder;        // 18

    ivec2 local = ivec2(gl_LocalInvocationID.xy);

    // Mismo espejo de borde que blend_irradiance.comp.
    ivec2 inner = local - ivec2(kDdgiBorder);
    if (inner.x < 0 || inner.x >= tile || inner.y < 0 || inner.y >= tile) {
        if (inner.x < 0)          { inner.x = 0;        inner.y = tile - 1 - inner.y; }
        else if (inner.x >= tile) { inner.x = tile - 1; inner.y = tile - 1 - inner.y; }
        if (inner.y < 0)          { inner.y = 0;        inner.x = tile - 1 - inner.x; }
        else if (inner.y >= tile) { inner.y = tile - 1; inner.x = tile - 1 - inner.x; }
        inner = clamp(inner, ivec2(0), ivec2(tile - 1));
    }

    vec2 oct    = (vec2(inner) + 0.5) / float(tile) * 2.0 - 1.0;
    vec3 dirOct = OctDecode(oct);

    int faceSize = uDdgiRange.z;
    int nTexels  = min(faceSize * faceSize, kDdgiFaceTexels);
    int nHilos   = int(gl_WorkGroupSize.x * gl_WorkGroupSize.y);

    // El exponente concentra el lobulo: para visibilidad conviene mucho mas
    // angosto que el coseno de la irradiancia, porque un borde de oclusion es
    // una discontinuidad y promediarla ancha la difumina y reintroduce leaking.
    const float kSharpness = 50.0;

    // -- Corte del lobulo --------------------------------------------------
    // Con un exponente de 50, una muestra con coseno 0.8 pesa 1.4e-5 de lo que
    // pesa una alineada. La masa de peso que queda por debajo del corte es
    // corte^(kSharpness+1) del total -- 1.1e-5 para 0.8 --, o sea que truncar ahi
    // cambia el resultado menos que el redondeo del half-float en el que se
    // guarda.
    //
    // A cambio saltea ~90% del bucle interno: de las 1536 direcciones del probe,
    // solo las ~138 que caen dentro del casquete aportan. Cada una salteada se
    // ahorra un pow() -- que a exponente arbitrario es un log2 y un exp2 -- y dos
    // multiply-add.
    //
    // El corte se DERIVA de kSharpness en vez de ser un numero magico: subir el
    // exponente sin mover el corte dejaria de ahorrar, y bajarlo empezaria a
    // truncar peso de verdad. Los dos son constantes, asi que el compilador
    // pliega el pow.
    const float kMasaDespreciada = 1.0e-5;
    const float kCorte = pow(kMasaDespreciada, 1.0 / kSharpness);

    float suma      = 0.0;
    float suma2     = 0.0;
    float sumaPesos = 0.0;

    for (int face = 0; face < 6; ++face) {
        // Protege el cache de la cara anterior: ver blend_irradiance.comp.
        barrier();
        for (int i = int(gl_LocalInvocationIndex); i < nTexels; i += nHilos) {
            int x = i % faceSize;
            int y = i / faceSize;

            vec2  ndc = (vec2(x, y) + 0.5) / float(faceSize) * 2.0 - 1.0;
            float r2  = 1.0 + ndc.x * ndc.x + ndc.y * ndc.y;

            // El cielo y lo que no pega nada vienen con 1e4. Se recorta al
            // far plane de la captura -- mas alla de eso no se capturo nada,
            // asi que guardar 1e4 solo destruye la precision del half-float.
            float dist = min(texelFetch(uCapture,
                                        ivec2(face * faceSize + x, slot * faceSize + y), 0).a,
                             uDdgiParams2.x);

            sDir[i]  = dirForFace(uint(face), ndc);
            sDist[i] = vec2(dist, 1.0 / (r2 * sqrt(r2)));
        }
        barrier();

        for (int i = 0; i < nTexels; ++i) {
            float coseno = dot(sDir[i], dirOct);
            if (coseno < kCorte) continue;

            float dist = sDist[i].x;
            float peso = pow(coseno, kSharpness) * sDist[i].y;

            suma      += dist * peso;
            suma2     += dist * dist * peso;
            sumaPesos += peso;
        }
    }

    vec2 capturado = (sumaPesos > 0.0) ? vec2(suma, suma2) / sumaPesos : vec2(0.0);

    ivec2 dst = DdgiTileOrigin(probe, bordered) + local;
    vec2  previo = imageLoad(uDistanceAtlas, dst).rg;

    vec2 resultado = mix(capturado, previo, uDdgiParams0.x);

    imageStore(uDistanceAtlas, dst, vec4(resultado, 0.0, 0.0));
}

#version 450 core
// Integra las distancias de los R rayos de cada probe al atlas de momentos (media,
// media^2) de Chebyshev.
layout(local_size_x = 18, local_size_y = 18, local_size_z = 1) in;   // kDistanceTile + 2

layout(binding = 0) uniform sampler2D uRays;
layout(rg16f, binding = 0) uniform image2D uDistanceAtlas;

#include "ddgi/common.glsl"
#include "ddgi/update.glsl"

shared float sDist[kDdgiMaxRays];
shared vec3  sDir[kDdgiMaxRays];

void main() {
    int slot = int(gl_WorkGroupID.x);
    if (slot >= DdgiSlotCount()) return;
    int probe = DdgiSlotProbe(slot);

    int   tile     = uDdgiAtlas.w;
    int   bordered = tile + 2 * kDdgiBorder;
    ivec2 local    = ivec2(gl_LocalInvocationID.xy);

    ivec2 inner = local - ivec2(kDdgiBorder);
    if (inner.x < 0 || inner.x >= tile || inner.y < 0 || inner.y >= tile) {
        if (inner.x < 0)          { inner.x = 0;        inner.y = tile - 1 - inner.y; }
        else if (inner.x >= tile) { inner.x = tile - 1; inner.y = tile - 1 - inner.y; }
        if (inner.y < 0)          { inner.y = 0;        inner.x = tile - 1 - inner.x; }
        else if (inner.y >= tile) { inner.y = tile - 1; inner.x = tile - 1 - inner.x; }
        inner = clamp(inner, ivec2(0), ivec2(tile - 1));
    }
    vec3 dirOct = OctDecode((vec2(inner) + 0.5) / float(tile) * 2.0 - 1.0);

    // Cara trasera: 1/5 de la distancia, como RTXGI, para que Chebyshev castigue al probe
    // que ve el dorso. El cielo cae al techo.
    float tope   = uUpdateHyst.w;
    int   nRayos = DdgiRayCount();
    int   nHilos = int(gl_WorkGroupSize.x * gl_WorkGroupSize.y);
    for (int i = int(gl_LocalInvocationIndex); i < nRayos; i += nHilos) {
        float a  = texelFetch(uRays, ivec2(i, slot), 0).a;
        sDir[i]  = DdgiRayDirection(i);
        sDist[i] = min((a < 0.0) ? -a * 0.2 : a, tope);
    }
    barrier();

    // Lobulo de RTXGI (probeDistanceExponent = 50). El corte saltea los rayos cuyo peso
    // no llega a 1e-5.
    const float kSharpness = 50.0;
    const float kCorte     = pow(1.0e-5, 1.0 / kSharpness);

    float suma = 0.0, suma2 = 0.0, sumaPesos = 0.0;
    for (int i = 0; i < nRayos; ++i) {
        float coseno = dot(sDir[i], dirOct);
        if (coseno < kCorte) continue;
        float peso = pow(coseno, kSharpness);
        suma      += sDist[i] * peso;
        suma2     += sDist[i] * sDist[i] * peso;
        sumaPesos += peso;
    }
    // Con pocos rayos un texel puede no tener ninguno en el lobulo: conserva lo que tenia.
    if (sumaPesos <= 0.0) return;

    ivec2 dst       = DdgiTileOrigin(probe, bordered) + local;
    vec2  previo    = imageLoad(uDistanceAtlas, dst).rg;
    vec2  capturado = vec2(suma, suma2) / sumaPesos;
    float h         = uDdgiParams0.x;
    imageStore(uDistanceAtlas, dst, vec4(mix(capturado, previo, h), 0.0, 0.0));
}

#version 450 core
// Traza los R rayos de cada probe de la lista contra el grid de voxeles.
// Workgroup = (grupo de 64 rayos, slot): gl_GlobalInvocationID.x es el rayo.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform image2D uRays;

layout(binding = 2) uniform sampler3D uVoxelAlbedo;
layout(binding = 3) uniform sampler3D uVoxelNormal;
layout(binding = 4) uniform samplerCube uEnvironment;
layout(binding = 5) uniform sampler3D uVoxelEmission;   // RGBM, ver voxel/emission.glsl

// El mapa de sombra UNICO de DDGI, no las cascadas: pbr.frag elige cascada por
// distancia a la CAMARA y una sonda lejos de la camara caeria fuera de todas.
layout(binding = 8) uniform sampler2D uShadowMap;

#include "common/frame.glsl"
#include "common/lights.glsl"
#include "ddgi/common.glsl"
#include "ddgi/update.glsl"
#include "voxel/emission.glsl"

// voxelize.frag: alfa 1.0 = una cara, 0.75 = doble cara.
const float kAlfaUnaCara     = 0.875;
// -0.0 no pasa el test a < 0: un probe dentro de un voxel solido pega a t = 0.
const float kDistanciaMinima = 1.0e-3;

vec3 OctDecodeNormal(vec2 e) {
    vec2 f = e * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    float t = max(-n.z, 0.0);
    n.xy += vec2(n.x >= 0.0 ? -t : t, n.y >= 0.0 ? -t : t);
    return normalize(n);
}

// Los bias y el offset por normal son los tuneados de la captura rasterizada. Sin PCF:
// un rayo pega en UN voxel y el promedio espacial lo hace el blend.
float SombraDelSol(vec3 mundo, vec3 N, vec3 L) {
    if (uShadowParams.x < 0.5) return 0.0;

    float NdotL    = dot(N, L);
    float sinTheta = sqrt(clamp(1.0 - NdotL * NdotL, 0.0, 1.0));
    vec3  muestra  = mundo + N * (uShadowParams.w * sinTheta);

    vec4 lp   = uLightSpaceMatrix * vec4(muestra, 1.0);
    vec3 proj = lp.xyz / lp.w;
    proj      = proj * 0.5 + 0.5;
    if (proj.z > 1.0) return 0.0;

    float bias = max(uShadowParams.z * (1.0 - NdotL), uShadowParams.y);
    return (proj.z - bias > texture(uShadowMap, proj.xy).r) ? 1.0 : 0.0;
}

// Slab test contra la AABB del grid. Sin esto, un probe afuera del grid veria cielo
// en todas las direcciones (reproducido en la simulacion del DDA).
float EntradaAlGrid(vec3 o, vec3 d, float extension, float maxDist) {
    float t0 = 0.0;
    float t1 = maxDist;
    for (int i = 0; i < 3; ++i) {
        float lo = uVoxelGrid[i];
        float hi = uVoxelGrid[i] + extension;
        if (abs(d[i]) < 1e-8) {
            if (o[i] < lo || o[i] > hi) return -1.0;
            continue;
        }
        float a = (lo - o[i]) / d[i];
        float b = (hi - o[i]) / d[i];
        t0 = max(t0, min(a, b));
        t1 = min(t1, max(a, b));
        if (t0 > t1) return -1.0;
    }
    return t0;
}

void main() {
    int slot = int(gl_WorkGroupID.y);
    if (slot >= DdgiSlotCount()) return;
    int rayo = int(gl_GlobalInvocationID.x);
    if (rayo >= DdgiRayCount()) return;

    int  probe  = DdgiSlotProbe(slot);
    vec3 origen = DdgiProbePosition(DdgiProbeCoords(probe));
    vec3 dir    = DdgiRayDirection(rayo);

    // El rayo corre hasta salir del grid: el clamp de Chebyshev vive en blend_distance.
    float maxDist    = 1.0e30;
    float voxelSize  = uVoxelParams.x;
    int   resolucion = int(uVoxelGrid.w);
    float umbral     = uVoxelParams.y;

    bool  hit     = false;
    float t       = 0.0;
    ivec3 v       = ivec3(0);
    float tSalida = -1.0;   // >= 0: el probe arranco adentro de un voxel solido

    float tEntrada = EntradaAlGrid(origen, dir, float(resolucion) * voxelSize, maxDist);
    if (tEntrada >= 0.0) {
        // Un epsilon adentro: sobre la cara exacta el floor cae en el voxel de afuera.
        float tIni    = (tEntrada > 0.0) ? tEntrada + voxelSize * 1e-4 : 0.0;
        vec3  arranca = origen + dir * tIni;

        // Amanatides-Woo. El clamp cubre el error de fp32 sobre la cara de entrada.
        v            = clamp(ivec3(floor((arranca - uVoxelGrid.xyz) / voxelSize)),
                             ivec3(0), ivec3(resolucion - 1));
        ivec3 paso   = ivec3(sign(dir));
        vec3  tDelta = abs(vec3(voxelSize) / max(abs(dir), vec3(1e-8)));
        vec3  tMax;
        for (int i = 0; i < 3; ++i) {
            float borde = uVoxelGrid[i] + float(v[i] + (dir[i] > 0.0 ? 1 : 0)) * voxelSize;
            tMax[i] = (abs(dir[i]) < 1e-8) ? 1e30 : (borde - arranca[i]) / dir[i];
        }

        float tLocal = 0.0;

        // Un rayo casi paralelo a un eje pisa hasta 3*resolucion voxeles.
        int maxPasos = 3 * resolucion;
        for (int i = 0; i < maxPasos; ++i) {
            if (any(lessThan(v, ivec3(0))) || any(greaterThanEqual(v, ivec3(resolucion)))) break;

            if (texelFetch(uVoxelAlbedo, v, 0).a >= umbral) { hit = true; break; }

            int eje = (tMax.x < tMax.y) ? ((tMax.x < tMax.z) ? 0 : 2)
                                        : ((tMax.y < tMax.z) ? 1 : 2);
            tLocal = tMax[eje];
            if (tIni + tLocal > maxDist) break;
            v[eje]    += paso[eje];
            tMax[eje] += tDelta[eje];
        }

        t = tIni + tLocal;

        // Origen adentro de un solido: se trata como cara trasera a la distancia de salida,
        // asi la regla 1 de la reubicacion lo saca por la salida mas corta.
        if (hit && tIni == 0.0 && tLocal == 0.0) {
            tSalida = 0.0;
            for (int i = 0; i < maxPasos; ++i) {
                int eje = (tMax.x < tMax.y) ? ((tMax.x < tMax.z) ? 0 : 2)
                                            : ((tMax.y < tMax.z) ? 1 : 2);
                tSalida    = tMax[eje];
                v[eje]    += paso[eje];
                tMax[eje] += tDelta[eje];
                if (any(lessThan(v, ivec3(0))) || any(greaterThanEqual(v, ivec3(resolucion)))) break;
                if (texelFetch(uVoxelAlbedo, v, 0).a < umbral) break;
            }
        }
    }

    ivec2 texel = ivec2(rayo, slot);

    if (tSalida >= 0.0) {
        imageStore(uRays, texel, vec4(0.0, 0.0, 0.0, -max(tSalida, kDistanciaMinima)));
        return;
    }

    vec3  radiancia;
    float distancia;

    if (hit) {
        vec4 voxel  = texelFetch(uVoxelAlbedo, v, 0);
        vec3 albedo = voxel.rgb;
        vec3 N      = OctDecodeNormal(texelFetch(uVoxelNormal, v, 0).rg);

        // Dorso de una cara simple: el probe esta adentro de algo.
        if (voxel.a > kAlfaUnaCara && dot(N, dir) > 0.0) {
            imageStore(uRays, texel, vec4(0.0, 0.0, 0.0, -max(t, kDistanciaMinima)));
            return;
        }
        if (dot(N, dir) > 0.0) N = -N;

        // Medio voxel afuera por N: el centro del voxel queda debajo de la superficie.
        vec3 mundo = origen + dir * t + N * (0.5 * voxelSize);

        // El /kDdgiPI es el contrato de RADIANCIA de la captura: sin el, la directa entra
        // PI veces de mas y el rebote la amplifica hasta una GI sobre-brillante estable.
        vec3 directa = vec3(0.0);
        for (uint i = 0u; i < uLightCounts.x; ++i) {
            GpuLight luz  = uLocalLights[i];
            vec3  Lvec    = luz.positionRange.xyz - mundo;
            float d2      = dot(Lvec, Lvec);
            float rango   = luz.positionRange.w;
            if (d2 >= rango * rango) continue;
            vec3  l       = Lvec * inversesqrt(max(d2, 1e-8));
            float att     = LightFalloff(d2, rango, luz.colorRadius.w) * SpotAngular(luz, l);
            directa += albedo / kDdgiPI * max(dot(N, l), 0.0) * luz.colorRadius.rgb * att;
        }
        for (uint i = 0u; i < uLightCounts.y; ++i) {
            vec3  L = normalize(-uDirDirection[i].xyz);
            float s = (uDirColor[i].w > 0.5) ? SombraDelSol(mundo, N, L) : 0.0;
            directa += (1.0 - s) * albedo / kDdgiPI * max(dot(N, L), 0.0) * uDirColor[i].rgb;
        }

        // La intensidad de DDGI NO va aca: se aplica una vez, en pbr.frag. Dos veces diverge.
        vec3 rebote = vec3(0.0);
        if (DdgiEnabled()) {
            vec3  hacia = origen - mundo;
            float dProb = length(hacia);
            hacia       = (dProb > 1e-5) ? hacia / dProb : N;

            rebote = albedo * SampleDdgiIrradiance(mundo, N, hacia) * DdgiVolumeFade(mundo);
        }

        vec3 emision = DecodeVoxelEmission(texelFetch(uVoxelEmission, v, 0));

        radiancia = directa + rebote + emision;
        distancia = t;
    } else {
        radiancia = (uIblParams.x > 0.5)
                  ? texture(uEnvironment, dir).rgb * uIblParams.y
                  : vec3(0.0);
        distancia = kDdgiSkyDistance;
    }

    imageStore(uRays, texel, vec4(radiancia, distancia));
}
